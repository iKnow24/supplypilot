# Copy to apps/web/.env.local (web) or export in your shell (optimizer).
# Nothing is required for the local demo: it runs entirely on synthetic seed data.

# Where the web app's server calls the optimizer service (Milestone 3+).
OPTIMIZER_URL=http://127.0.0.1:8000

# Optimizer: override the catalog file (defaults to data/seed/demo_catalog.json).
# SUPPLYPILOT_CATALOG_PATH=

# Supabase (carts, saved lists). `make db-start` / `make db-env` write these into
# apps/web/.env.local for the local stack. Only the publishable key is used by the app;
# never put the service-role key in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo sign-in as the fictional buyer picked in the switcher. Local/demo only.
# DEMO_AUTH=on
